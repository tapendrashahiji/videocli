{
  "schema": "videocli.template/v1",
  "name": "title-card",
  "baker": "titles",
  "design": "title-card",
  "params": {
    "title": {
      "type": "string",
      "required": true,
      "max_chars": 40
    },
    "subtitle": {
      "type": "string",
      "default": "",
      "max_chars": 60
    },
    "background": {
      "type": "color",
      "default": "brand.primary"
    },
    "dim": {
      "type": "number",
      "default": 0.0,
      "min": 0,
      "max": 1
    },
    "scale": {
      "type": "number",
      "default": 1.0,
      "min": 0.4,
      "max": 2.5
    },
    "box_x": {
      "type": "number",
      "min": 0,
      "max": 1
    },
    "box_y": {
      "type": "number",
      "min": 0,
      "max": 1
    },
    "animation": {
      "type": "choice",
      "choices": [
        "fade",
        "scale",
        "typewriter"
      ],
      "default": "fade"
    }
  },
  "duration": {
    "default": 3.0,
    "min": 1.5,
    "in": 0.5,
    "out": 0.5
  },
  "placement": {
    "anchor": "center",
    "safe_area": true
  },
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ]
}
