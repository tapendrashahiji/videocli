{
  "schema": "videocli.template/v1",
  "name": "callout",
  "baker": "titles",
  "design": "callout",
  "params": {
    "text": {
      "type": "string",
      "required": true,
      "max_chars": 40
    },
    "x": {
      "type": "number",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    "y": {
      "type": "number",
      "default": 0.4,
      "min": 0,
      "max": 1
    },
    "accent": {
      "type": "color",
      "default": "brand.accent"
    },
    "scale": {
      "type": "number",
      "default": 1.0,
      "min": 0.4,
      "max": 2.5
    },
    "animation": {
      "type": "choice",
      "choices": [
        "scale",
        "fade"
      ],
      "default": "scale"
    }
  },
  "duration": {
    "default": 3.0,
    "min": 1.5,
    "in": 0.3,
    "out": 0.3
  },
  "placement": {
    "anchor": "point",
    "safe_area": true
  },
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ]
}
