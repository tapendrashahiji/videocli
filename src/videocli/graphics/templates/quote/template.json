{
  "schema": "videocli.template/v1",
  "name": "quote",
  "baker": "titles",
  "design": "quote",
  "params": {
    "text": {
      "type": "string",
      "required": true,
      "max_chars": 160
    },
    "author": {
      "type": "string",
      "default": "",
      "max_chars": 40
    },
    "scale": {
      "type": "number",
      "default": 1.0,
      "min": 0.4,
      "max": 2.5
    },
    "box_x": {
      "type": "number",
      "min": 0,
      "max": 1
    },
    "box_y": {
      "type": "number",
      "min": 0,
      "max": 1
    },
    "animation": {
      "type": "choice",
      "choices": [
        "fade",
        "typewriter"
      ],
      "default": "fade"
    }
  },
  "duration": {
    "default": 6.0,
    "min": 3.0,
    "in": 0.6,
    "out": 0.6
  },
  "placement": {
    "anchor": "center",
    "safe_area": true
  },
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ]
}
