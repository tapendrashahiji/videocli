{
  "schema": "videocli.template/v1",
  "name": "end-card",
  "baker": "titles",
  "design": "end-card",
  "params": {
    "title": {
      "type": "string",
      "required": true,
      "max_chars": 40
    },
    "subtitle": {
      "type": "string",
      "default": "",
      "max_chars": 60
    },
    "background": {
      "type": "color",
      "default": "brand.primary"
    },
    "animation": {
      "type": "choice",
      "choices": [
        "fade",
        "scale"
      ],
      "default": "fade"
    }
  },
  "duration": {
    "default": 5.0,
    "min": 2.0,
    "in": 0.6,
    "out": 0.6
  },
  "placement": {
    "anchor": "center",
    "safe_area": true
  },
  "aspects": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ]
}